<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Reconstruct widget jobs on the destination device. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="blocknize.db" />
        <include domain="database" path="blocknize.db-wal" />
        <include domain="database" path="blocknize.db-shm" />
        <include domain="file" path="datastore/appearance.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="blocknize.db" />
        <include domain="database" path="blocknize.db-wal" />
        <include domain="database" path="blocknize.db-shm" />
        <include domain="file" path="datastore/appearance.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
