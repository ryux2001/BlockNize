{
  "name": "@blocknize/backend",
  "version": "0.1.0",
  "private": true,
  "description": "BlockNize REST API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test:unit": "npm run build && node --test test/civil-time.test.mjs",
    "test:database": "node --test test/database-constraints.test.mjs",
    "test:api": "node --test --test-concurrency=1 test/auth-acceptance.test.mjs test/api-workflows.test.mjs",
    "test:acceptance": "npm run build && node scripts/neon-auth-acceptance.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.2"
  }
}
