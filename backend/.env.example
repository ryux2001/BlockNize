NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@HOST/DB?sslmode=require
NEON_AUTH_JWKS_URL=https://YOUR-AUTH-HOST/.well-known/jwks.json
NEON_AUTH_ISSUER=https://YOUR-AUTH-HOST
# Set only if the token issued by your Neon Auth branch contains an audience claim.
NEON_AUTH_AUDIENCE=
CORS_ORIGINS=http://localhost:3000
